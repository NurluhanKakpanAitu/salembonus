# Серверде /opt/salembonus/.env деп сақталады. Git-ке кірмейді.
# Әрқайсысын өз мәніңмен толтыр, бос қалдырма.

# Базаның паролі: openssl rand -base64 24
DB_PASSWORD=

# JWT қолтаңба кілті (32+ таңба): openssl rand -base64 48
JWT_KEY=

# Let's Encrypt сертификат хабарламалары үшін пошта
ACME_EMAIL=nurlykhankakpan@gmail.com

# Демо үшін тұрақты SMS коды. Нақты клиенттерге ашқанда бос қалдыр.
STATIC_OTP_CODE=1234

# ---------- SalemPos ----------
# Cloudflare R2, тауар суреттері. Токен: R2 → Manage API tokens → Object Read & Write,
# ТЕК salem-media бакетіне. Девтегі salem-api-dev токенін мұнда қолданба.
R2_ACCOUNT_ID=
R2_BUCKET=salem-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Бакеттің өз домені (Custom domain), r2.dev емес
R2_PUBLIC_URL=https://cdn.salemtech.kz

# Түнгі бэкаптың R2 көшірмесі (міндетті емес, бірақ ұсынылады). Бөлек токен, ТЕК salem-backups
# бакетіне. Бос қалса, бэкап тек серверде сақталады.
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
