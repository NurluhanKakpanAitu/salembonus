{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "https://salembonus.kz",
      "https://www.salembonus.kz"
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "salembonus",
    "Audience": "salembonus-app",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "OtpLength": 4,
    "OtpLifetimeSeconds": 300,
    "OtpResendSeconds": 60,
    "OtpMaxAttempts": 5,
    "ReturnCodeInResponse": false
  },
  "Sms": {
    "Provider": "Log"
  }
}